import { Button, ComboBox, Slider, TextEdit, LineEdit } from "std-widgets.slint";

component ShortcutRow inherits HorizontalLayout {
    in property <string> action;
    in property <string> shortcut;
    Text { text: root.action; color: #a2a5b3; font-size: 12px; vertical-alignment: center; }
    Text { text: root.shortcut; color: #c3bed6; font-size: 12px; horizontal-alignment: right; vertical-alignment: center; }
}

component SettingsNavItem inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback activated();
    height: 38px;
    border-radius: 7px;
    background: root.selected ? #100d19.with-alpha(0.5) : (touch.has-hover ? #100d19.with-alpha(0.3) : transparent);
    border-width: root.selected ? 1px : 0px;
    border-color: #49405f;
    Text {
        text: root.label;
        color: root.selected ? #c4b7f5 : #b9b7c8;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        accessible-role: button;
        accessible-label: root.label;
        mouse-cursor: pointer;
        clicked => { root.activated(); }
    }
}

export component SettingsPanel inherits Rectangle {
    in-out property <string> draft;
    in property <string> current-hotkey;
    in property <string> message;
    in property <bool> failed;
    in property <bool> background-busy;
    in-out property <string> background-path;
    in-out property <int> background-rotation;
    in-out property <float> background-opacity: 1;
    in-out property <float> background-blur: 0;
    callback save-appearance(string, float, float, int);
    callback browse-background();
    callback clear-background-cache();
    in-out property <string> window-width-draft;
    in-out property <string> window-height-draft;
    callback save-window-size(string, string);
    in-out property <int> page: 0;
    in property <bool> autostart-registered;
    in property <bool> autostart-available;
    in property <bool> autostart-busy;
    in property <bool> autostart-system-settings;
    in property <bool> autostart-failed;
    in property <string> autostart-status;
    in property <string> autostart-message;
    callback set-autostart(bool);
    callback refresh-autostart();
    callback open-autostart-system-settings();
    in property <[string]> addon-list;
    in-out property <int> addon-selected: -1;
    in-out property <string> addon-manifest-draft;
    in-out property <string> addon-config-draft;
    in property <bool> addon-enabled;
    in property <string> addon-message;
    in property <bool> addon-failed;
    callback addon-select(int);
    callback addon-add(string);
    callback addon-remove(int);
    callback addon-set-enabled(int, bool);
    callback addon-save-config(int, string);
    in-out property <int> file-backend-draft;
    in-out property <string> file-backend-program;
    in property <bool> file-everything-available;
    callback save-file-backend(int, string);
    in-out property <string> file-roots-draft;
    in property <bool> file-indexing;
    in property <bool> file-settings-busy;
    in property <bool> file-folder-dialog-open;
    in property <bool> file-settings-failed;
    in property <string> file-index-status;
    in property <string> file-settings-message;
    callback save-file-roots(string);
    callback browse-file-folder();
    callback rebuild-file-index();
    callback clear-file-index();
    callback save(string);
    callback restore-default();
    callback close();
    callback capture-key(string, bool, bool, bool, bool);
    out property <bool> recording: root.page == 0 && hotkey-recorder.has-focus && root.visible;
    public function focus-editor() {
        if (root.page == 0) { hotkey-recorder.focus(); }
        else { page-focus.focus(); }
    }

    background: #191a20;
    border-bottom-left-radius: 17px;
    border-bottom-right-radius: 17px;
    TouchArea { }
    // Consume keyboard events here so editing never launches or quits an app.
    page-focus := FocusScope {
        capture-key-pressed(event) => {
            if (event.text == Key.Escape && !event.modifiers.control && !event.modifiers.alt && !event.modifiers.shift && !event.modifiers.meta) {
                root.close(); return accept;
            }
            return reject;
        }
        HorizontalLayout {
            padding: 0px;
            spacing: 0px;
            Rectangle {
                width: 148px;
                background: #16171d;
                border-bottom-left-radius: 17px;
                VerticalLayout {
                    padding: 14px;
                    spacing: 12px;
                    Text { text: "设置"; color: #858896; font-size: 12px; }
                    SettingsNavItem { label: "快捷键设置"; selected: root.page == 0; activated => { root.page = 0; root.focus-editor(); } }
                    SettingsNavItem { label: "外观设置"; selected: root.page == 1; activated => { root.page = 1; root.focus-editor(); } }
                    SettingsNavItem { label: "开机自启"; selected: root.page == 2; activated => { root.page = 2; root.focus-editor(); root.refresh-autostart(); } }
                    SettingsNavItem { label: "窗口大小"; selected: root.page == 4; activated => { root.page = 4; root.focus-editor(); } }
                    SettingsNavItem { label: "文件搜索"; selected: root.page == 3; activated => { root.page = 3; root.focus-editor(); } }
                    SettingsNavItem { label: "插件"; selected: root.page == 5; activated => { root.page = 5; root.focus-editor(); } }
                    Rectangle { vertical-stretch: 1; }
                    Button { text: "返回面板"; clicked => { root.close(); } }
                }
            }
            Rectangle {
            VerticalLayout {
                visible: root.page == 0;
                padding: 24px;
                spacing: 12px;
                Text { text: "快捷键设置"; color: #f0eef8; font-size: 21px; font-weight: 600; }
                Text { text: "自定义显示 / 隐藏面板的全局快捷键"; color: #858896; font-size: 12px; }
                Rectangle { height: 6px; }
                Text { text: "显示 / 隐藏面板"; color: #e7e7ef; font-size: 13px; }
                Rectangle {
                    height: 36px;
                    border-radius: 6px;
                    background: #22242c;
                    border-width: 1px;
                    border-color: hotkey-recorder.has-focus ? #b6a9ff : #34363f;
                    hotkey-recorder := FocusScope {
                        accessible-role: button;
                        accessible-label: "快捷键录入，按下组合键";
                        key-pressed(event) => {
                            if ((event.text == Key.Tab || event.text == Key.Backtab)
                                && !event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta) {
                                return reject;
                            }
                            if (!event.repeat) {
                                root.capture-key(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta);
                            }
                            return accept;
                        }
                        Text {
                            x: 12px; width: parent.width - 24px; height: parent.height;
                            text: root.draft == "" ? "请按下快捷键组合…" : root.draft;
                            color: root.draft == "" ? #858896 : #f0eef8;
                            font-size: 14px; vertical-alignment: center;
                            overflow: elide;
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { hotkey-recorder.focus(); }
                        }
                    }
                }
                Text { text: "当前：" + root.current-hotkey; color: #858896; font-size: 11px; }
                Text {
                    text: "点击上方区域，直接按下组合键，再点击保存。\nmacOS：Alt = Option，Super = Command。";
                    color: #747785; font-size: 11px;
                }
                HorizontalLayout {
                    spacing: 10px;
                    Button { text: "恢复默认"; clicked => { root.restore-default(); } }
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: "保存快捷键"; primary: true; clicked => { root.save(root.draft); } }
                }
                Text {
                    min-height: 32px;
                    text: root.message;
                    color: root.failed ? #ef9b9b : #84c7b5;
                    font-size: 11px;
                    wrap: word-wrap;
                }
                Rectangle { height: 1px; background: #2c2e37; }
                Text { text: "面板内快捷键"; color: #858896; font-size: 11px; }
                ShortcutRow { action: "选择应用"; shortcut: "↑ / ↓"; }
                ShortcutRow { action: "打开 / 新开实例"; shortcut: "Enter / Shift + Enter"; }
                ShortcutRow { action: "隐藏 / 刷新 / 退出"; shortcut: "Esc / Ctrl + R / Ctrl + Q"; }
                Rectangle { vertical-stretch: 1; }
            }
            if root.page == 1: VerticalLayout {
                padding: 24px;
                spacing: 12px;
                Text { text: "外观设置"; color: #f0eef8; font-size: 21px; font-weight: 600; }
                Text { text: "背景图片（每行一个路径，留空恢复默认）"; color: #a2a5b3; font-size: 12px; }
                HorizontalLayout {
                    spacing: 8px;
                    TextEdit { height: 75px; text <=> root.background-path; placeholder-text: "输入图片路径，或添加多张图片"; }
                    Button { text: "添加图片…"; clicked => { root.browse-background(); } }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "切换方式"; color: #e7e7ef; vertical-alignment: center; }
                    ComboBox { model: ["固定第一张", "每次唤出时切换", "每 1 分钟", "每 5 分钟", "每 15 分钟", "每 30 分钟", "每 1 小时"]; current-index <=> root.background-rotation; }
                }
                Text { text: "图片不透明度：" + round(root.background-opacity * 100) + "%"; color: #e7e7ef; }
                Slider { minimum: 0; maximum: 1; value <=> root.background-opacity; }
                Text { text: "高斯模糊：" + round(root.background-blur) + " px"; color: #e7e7ef; }
                Slider { minimum: 0; maximum: 30; value <=> root.background-blur; }
                HorizontalLayout {
                    spacing: 8px;
                    Button { text: root.background-busy ? "正在处理…" : "保存外观"; enabled: !root.background-busy; primary: true; clicked => { root.save-appearance(root.background-path, root.background-opacity, root.background-blur, root.background-rotation); } }
                    Button { text: "清空背景缓存"; enabled: !root.background-busy; clicked => { root.clear-background-cache(); } }
                }
                Text { text: root.message; color: root.failed ? #ef9b9b : #84c7b5; font-size: 11px; wrap: word-wrap; }
                Rectangle { vertical-stretch: 1; }
            }
            if root.page == 4: VerticalLayout {
                padding: 24px;
                spacing: 16px;
                Text { text: "窗口大小"; color: #f0eef8; font-size: 21px; font-weight: 600; }
                Text { text: "设置面板的宽度和高度（逻辑像素）。"; color: #a2a5b3; font-size: 12px; }
                HorizontalLayout {
                    spacing: 10px;
                    Text { text: "宽度"; color: #e7e7ef; vertical-alignment: center; }
                    LineEdit { text <=> root.window-width-draft; input-type: number; }
                    Text { text: "高度"; color: #e7e7ef; vertical-alignment: center; }
                    LineEdit { text <=> root.window-height-draft; input-type: number; }
                }
                Text { text: "宽度 680–1920，高度 540–1440；默认 680 × 540。"; color: #858896; font-size: 11px; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 10px;
                    Button { text: "恢复默认"; clicked => { root.window-width-draft = "680"; root.window-height-draft = "540"; } }
                    Button { text: "保存窗口大小"; primary: true; enabled: !root.background-busy; clicked => { root.save-window-size(root.window-width-draft, root.window-height-draft); } }
                }
                Text { text: root.message; color: root.failed ? #ef9b9b : #84c7b5; font-size: 11px; wrap: word-wrap; }
                Rectangle { vertical-stretch: 1; }
            }
            if root.page == 2: VerticalLayout {
                padding: 24px;
                spacing: 16px;
                Text { text: "开机自启"; color: #f0eef8; font-size: 21px; font-weight: 600; }
                Text {
                    text: "登录系统后在后台启动 Take a Panel。\n使用全局快捷键或 P 菜单唤出面板。";
                    color: #a2a5b3; font-size: 12px; wrap: word-wrap;
                }
                Text { text: root.autostart-status; color: #e7e7ef; font-size: 14px; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 10px;
                    Button {
                        text: root.autostart-busy ? "正在处理…" : (root.autostart-registered ? "关闭开机自启" : "请求开机自启");
                        primary: !root.autostart-registered;
                        enabled: root.autostart-available && !root.autostart-busy;
                        clicked => { root.set-autostart(!root.autostart-registered); }
                    }
                    Button { text: "刷新状态"; enabled: !root.autostart-busy; clicked => { root.refresh-autostart(); } }
                }
                if root.autostart-system-settings: Button {
                    text: "打开系统启动项设置";
                    enabled: !root.autostart-busy;
                    clicked => { root.open-autostart-system-settings(); }
                }
                Text {
                    text: root.autostart-message;
                    color: root.autostart-failed ? #ef9b9b : #84c7b5;
                    font-size: 12px; wrap: word-wrap;
                }
                Rectangle { vertical-stretch: 1; }
            }
            if root.page == 5: VerticalLayout {
                padding: 20px; spacing: 7px;
                Text { text: "插件"; color: #f0eef8; font-size: 21px; font-weight: 600; }
                Text { text: "添加插件的 manifest.json 路径。插件会以当前用户权限运行。"; color: #a2a5b3; font-size: 11px; wrap: word-wrap; }
                HorizontalLayout { spacing: 8px;
                    LineEdit { text <=> root.addon-manifest-draft; placeholder-text: "插件清单的完整路径"; }
                    Button { text: "添加插件"; clicked => { root.addon-add(root.addon-manifest-draft); } }
                }
                HorizontalLayout { spacing: 8px;
                    ComboBox { model: root.addon-list; current-index <=> root.addon-selected; selected(value) => { root.addon-select(self.current-index); } }
                    Button { text: root.addon-enabled ? "停用" : "启用"; enabled: root.addon-selected >= 0; clicked => { root.addon-set-enabled(root.addon-selected, !root.addon-enabled); } }
                    Button { text: "删除"; enabled: root.addon-selected >= 0; clicked => { root.addon-remove(root.addon-selected); } }
                }
                Text { text: "插件配置（JSON 对象）"; color: #e7e7ef; font-size: 12px; }
                TextEdit { height: 90px; text <=> root.addon-config-draft; enabled: root.addon-selected >= 0; }
                Button { text: "保存插件配置"; enabled: root.addon-selected >= 0; clicked => { root.addon-save-config(root.addon-selected, root.addon-config-draft); } }
                Text { text: root.addon-message; color: root.addon-failed ? #ef9b9b : #84c7b5; font-size: 11px; wrap: word-wrap; }
                Rectangle { vertical-stretch: 1; }
            }
            if root.page == 3: VerticalLayout {
                padding: 20px;
                spacing: 6px;
                Text { text: "文件搜索"; color: #f0eef8; font-size: 21px; font-weight: 600; }
                HorizontalLayout {
                    spacing: 6px;
                    ComboBox { model: root.file-everything-available ? ["内置", "ripgrep (rg)", "fd", "Everything (es)"] : ["内置", "ripgrep (rg)", "fd"]; current-index <=> root.file-backend-draft; }
                    LineEdit { text <=> root.file-backend-program; placeholder-text: "程序路径（留空使用 PATH）"; enabled: root.file-backend-draft != 0; }
                    Button { text: "保存后端"; enabled: !root.file-settings-busy && !root.file-folder-dialog-open; clicked => { root.save-file-backend(root.file-backend-draft, root.file-backend-program); } }
                }
                Text { text: root.file-backend-draft == 3 ? "Everything 使用自身索引；需运行 Everything 并安装 ES。" : "索引范围：每行一个目录，支持 ~/；留空停用索引。"; color: #a2a5b3; font-size: 11px; wrap: word-wrap; }
                Button {
                    text: root.file-folder-dialog-open ? "正在选择文件夹…" : "添加文件夹…";
                    enabled: !root.file-settings-busy && !root.file-folder-dialog-open;
                    clicked => { root.browse-file-folder(); }
                }
                TextEdit {
                    height: 70px;
                    text <=> root.file-roots-draft;
                    placeholder-text: "例如：~/Documents\n~/Downloads";
                    enabled: !root.file-settings-busy && !root.file-folder-dialog-open;
                }

                HorizontalLayout {
                    spacing: 10px;
                    Button { text: "清空索引缓存"; enabled: !root.file-settings-busy && !root.file-folder-dialog-open; clicked => { root.clear-file-index(); } }
                    Button { text: "重建索引"; enabled: !root.file-settings-busy && !root.file-folder-dialog-open; clicked => { root.rebuild-file-index(); } }
                    Button { text: root.file-settings-busy ? "正在保存…" : "保存并重建索引"; primary: true; enabled: !root.file-settings-busy && !root.file-folder-dialog-open; clicked => { root.save-file-roots(root.file-roots-draft); } }
                }
                Text { text: root.file-index-status; color: #a2a5b3; font-size: 11px; wrap: word-wrap; }
                Text { text: root.file-settings-message; color: root.file-settings-failed ? #ef9b9b : #84c7b5; font-size: 11px; wrap: word-wrap; }

                Rectangle { vertical-stretch: 1; }
            }
            }
        }
    }
}
