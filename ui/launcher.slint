import { AppTheme } from "theme.slint";
import { Button, ListView, Palette, ComboBox, TextEdit, ScrollView, LineEdit } from "std-widgets.slint";
import { SettingsPanel, AddonSettingRow } from "settings.slint";
export { AddonSettingRow } from "settings.slint";
export { LauncherTray } from "tray.slint";

export struct AddonPanelRow {
    key: string,
    label: string,
    kind: int,
    value: string,
    options: [string],
    option-index: int,
}

export struct AppRow {
    name: string,
    detail: string,
    monogram: string,
    tint: color,
    icon: image,
    has-icon: bool,
    app-result: bool,
    addon-result: bool,
    has-path: bool,
}

component ContextItem inherits Rectangle {
    in property <string> label;
    in property <string> shortcut;
    callback activated();
    height: 34px;
    border-radius: 6px;
    background: touch.has-hover ? (AppTheme.light ? #625580 : #100d19).with-alpha(0.45) : transparent;
    HorizontalLayout {
        padding-left: 12px; padding-right: 12px;
        Text { text: root.label; color: (AppTheme.light ? #292735 : #e7e7ef); font-size: 12px; vertical-alignment: center; }
        Rectangle { horizontal-stretch: 1; }
        Text { text: root.shortcut; color: (AppTheme.light ? #686575 : #898797); font-size: 11px; vertical-alignment: center; }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.activated(); } }
}

component KeyCap inherits Rectangle {
    in property <string> label;
    min-height: 22px;
    width: max(24px, label-text.preferred-width + 12px);
    Rectangle {
        y: (parent.height - self.height) / 2;
        width: parent.width;
        height: 22px;
        border-radius: 5px;
        background: (AppTheme.light ? #eeedf4 : #24262d);
        border-width: 1px;
        border-color: (AppTheme.light ? #d0ceda : #34363f);
        label-text := Text {
            text: root.label;
            color: (AppTheme.light ? #626170 : #a2a5b3);
            font-size: 11px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

export component LauncherWindow inherits Window {
    title: "Take a Panel";
    icon: @image-url("assets/tray-p.svg");
    width: root.window-width * 1px;
    height: root.window-height * 1px;
    no-frame: true;
    always-on-top: true;
    background: transparent;
    default-font-size: 14px;
    default-font-weight: 400;
    init => { Palette.color-scheme = AppTheme.light ? ColorScheme.light : ColorScheme.dark; }
    changed light-mode => {
        Palette.color-scheme = root.light-mode ? ColorScheme.light : ColorScheme.dark;
        root.theme-changed();
    }
    in property <bool> light-mode: AppTheme.light;
    in-out property <int> theme-mode <=> AppTheme.mode;
    in-out property <bool> system-light <=> AppTheme.system-light;
    callback set-theme(int);
    callback theme-changed();

    in property <int> window-width: 680;
    in property <int> window-height: 540;
    in-out property <string> window-width-draft: "680";
    in-out property <string> window-height-draft: "540";
    callback save-window-size(string, string);
    callback window-size-applied();
    in property <image> background-image;
    in property <bool> background-busy;
    in-out property <string> background-path;
    in-out property <int> background-rotation;
    in-out property <float> background-opacity: 1;
    in-out property <float> background-blur: 0;
    callback save-appearance(string, float, float, int);
    callback background-presented();
    callback browse-background();
    callback clear-background-cache();
    in property <bool> autostart-registered;
    in property <bool> autostart-available;
    in property <bool> autostart-busy;
    in property <bool> autostart-system-settings;
    in property <bool> autostart-failed;
    in property <string> autostart-status: "正在读取系统状态…";
    in property <string> autostart-message;
    callback set-autostart(bool);
    callback refresh-autostart();
    callback open-autostart-system-settings();
    in-out property <bool> file-search-mode;
    in-out property <bool> clipboard-mode;
    in-out property <bool> addon-panel-open;
    in property <bool> addon-panel-busy;
    in property <string> addon-panel-title;
    in property <string> addon-panel-focus;
    property <int> addon-panel-focus-request;
    in property <string> addon-panel-submit-label;
    in property <string> addon-panel-message;
    in property <[AddonPanelRow]> addon-panel-fields;
    callback addon-panel-edited(int, string);
    callback addon-panel-submit();
    callback addon-panel-close();
    in property <bool> file-indexing;
    in property <bool> file-querying;
    in property <bool> file-settings-busy;
    in property <bool> file-folder-dialog-open;
    in property <bool> file-settings-failed;
    in property <int> file-count;
    in property <int> file-match-count;
    in property <string> file-index-status;
    in property <string> file-settings-message;
    in property <[string]> addon-list;
    in-out property <int> addon-selected: -1;
    in-out property <string> addon-manifest-draft;
    in-out property <string> addon-config-draft;
    in property <[AddonSettingRow]> addon-fields;
    callback addon-field-edited(int, string);
    callback addon-save-fields(int);
    in property <bool> addon-enabled;
    in property <string> addon-message;
    in property <bool> addon-failed;
    callback addon-select(int);
    in property <bool> addon-dialog-open;
    callback addon-browse();
    callback addon-add(string);
    callback addon-remove(int);
    callback addon-set-enabled(int, bool);
    callback addon-save-config(int, string);
    in property <int> file-backend-active: 0;
    in-out property <int> file-backend-draft: 0;
    in-out property <string> file-backend-program;
    in property <bool> file-everything-available;
    callback save-file-backend(int, string);
    in-out property <string> file-roots-draft;
    callback save-file-roots(string);
    callback browse-file-folder();
    callback rebuild-file-index();
    callback clear-file-index();
    in property <[AppRow]> results;
    in property <int> total-count;
    in property <bool> scanning: true;
    in property <bool> launching: false;
    in property <string> hotkey-label: "Ctrl + Alt + Space";
    in property <string> notice;
    in property <string> error-message;
    in-out property <string> query;
    in-out property <int> selected-index: 0;
    property <bool> context-open: false;
    property <length> context-x;
    property <length> context-y;
    property <int> context-index: -1;
    property <bool> context-app: false;
    property <bool> context-path: false;
    property <bool> addon-selected-result: !root.file-search-mode && !root.clipboard-mode
        && root.selected-index >= 0 && root.selected-index < root.results.length
        && root.results[root.selected-index].addon-result;
    property <bool> calculation-selected: !root.file-search-mode && !root.clipboard-mode
        && root.selected-index >= 0 && root.selected-index < root.results.length
        && root.results[root.selected-index].monogram == "=";
    in property <string> configured-hotkey: "Ctrl+Alt+Space";
    in property <string> default-hotkey: "Ctrl+Alt+Space";
    in-out property <bool> settings-open: false;
    in-out property <string> shortcut-draft;
    in-out property <string> settings-message;
    in-out property <bool> settings-failed: false;
    out property <bool> shortcut-recording: root.settings-open && settings-panel.recording;
    callback query-edited(string);
    callback launch-selected(int, bool);
    callback copy-result-path(int);
    callback dismiss();
    callback refresh();
    callback refresh-apps();
    callback quit();
    callback save-shortcut(string);
    callback capture-shortcut(string, bool, bool, bool, bool);

    public function open-settings() {
        root.context-open = false;
        root.shortcut-draft = root.configured-hotkey;
        root.settings-message = "";
        root.settings-failed = false;
        root.settings-open = true;
        settings-panel.page = 0;
        settings-panel.focus-editor();
    }

    public function open-autostart-settings() {
        root.open-settings();
        settings-panel.page = 2;
        settings-panel.focus-editor();
        root.refresh-autostart();
    }

    public function close-settings() {
        root.settings-open = false;
        root.focus-search();
    }

    public function open-file-search-settings() {
        root.open-settings();
        settings-panel.page = 3;
        settings-panel.focus-editor();
    }

    public function leave-file-search() {
        root.context-open = false;
        root.file-search-mode = false;
        root.clipboard-mode = false;
        root.query = "";
        root.selected-index = 0;
        results-view.content-y = 0px;
        root.query-edited("");
        search.focus();
    }

    public function focus-search() {
        if (root.settings-open) { settings-panel.focus-editor(); }
        else if (root.addon-panel-open) { panel-focus.focus(); root.addon-panel-focus-request += 1; }
        else { search.focus(); }
    }

    public function close-context-menu() {
        root.context-open = false;
    }

    public function reset-search() {
        root.context-open = false;
        root.settings-open = false;
        if (root.addon-panel-open) { root.addon-panel-close(); }
        root.file-search-mode = false;
        root.clipboard-mode = false;
        root.query = "";
        root.selected-index = 0;
        results-view.content-y = 0px;
        root.query-edited("");
        search.focus();
    }

    function scroll-to-selection() {
        if (root.selected-index * 66px < -results-view.content-y) {
            results-view.content-y = -root.selected-index * 66px;
        }
        if ((root.selected-index + 1) * 66px > -results-view.content-y + results-view.visible-height) {
            results-view.content-y = results-view.visible-height - (root.selected-index + 1) * 66px;
        }
    }

    Rectangle {
        x: 12px;
        y: 12px;
        width: parent.width - 24px;
        height: parent.height - 24px;
        background: (AppTheme.light ? #f8f7fb : #191a20);
        border-radius: 18px;
        border-color: (AppTheme.light ? #d7d4e0 : #363841);
        border-width: 1px;
        clip: true;

        Image { width: parent.width; height: parent.height; source: root.background-image; image-fit: cover; }
        VerticalLayout {
            spacing: 0px;
            padding: 0px;

            Rectangle {
                height: 45px;
                WindowMoveArea { }
                HorizontalLayout {
                    padding-left: 22px;
                    padding-right: 18px;
                    spacing: 9px;
                    Rectangle {
                        width: 7px;
                        Rectangle {
                            y: (parent.height - 7px) / 2;
                            width: 7px; height: 7px; border-radius: 4px;
                            background: (AppTheme.light ? #6d55bf : #a89bff);
                        }
                    }
                    Text { text: root.file-search-mode ? "文件搜索 · Esc 返回" : "TAKE A PANEL"; color: (AppTheme.light ? #565267 : #b9b7c8); font-size: 11px; font-weight: 700; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    Text { text: root.hotkey-label; color: (AppTheme.light ? #696777 : #747785); font-size: 11px; vertical-alignment: center; }
                    Rectangle {
                        width: 42px;
                        Rectangle {
                            y: (parent.height - 25px) / 2;
                            width: parent.width; height: 25px; border-radius: 6px;
                            background: settings-touch.has-hover ? (AppTheme.light ? #625580 : #100d19).with-alpha(0.4) : transparent;
                            Image {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                width: 18px; height: 18px;
                                source: @image-url("assets/settings.svg");
                                colorize: AppTheme.light ? #565267 : transparent;
                            }
                        }
                        settings-touch := TouchArea {
                            accessible-role: button;
                            accessible-label: "设置";
                            mouse-cursor: pointer;
                            clicked => { root.open-settings(); }
                        }
                    }
                    Rectangle {
                        width: 25px;
                        Rectangle {
                            y: (parent.height - 25px) / 2;
                            width: 25px; height: 25px; border-radius: 6px;
                            background: quit-touch.has-hover ? (AppTheme.light ? #625580 : #100d19).with-alpha(0.4) : transparent;
                            Text { text: "×"; color: (AppTheme.light ? #656373 : #9193a2); horizontal-alignment: center; vertical-alignment: center; font-size: 19px; }
                        }
                        quit-touch := TouchArea { clicked => { root.dismiss(); } }
                    }
                }
            }

            Rectangle {
                visible: !root.addon-panel-open;
                height: 68px;
                HorizontalLayout {
                    padding-left: 24px; padding-right: 24px; spacing: 16px;
                    Rectangle {
                        width: 24px;
                        Path {
                            y: (parent.height - 24px) / 2;
                            width: 24px; height: 24px;
                            commands: "M 16 16 L 22 22 M 18 10 A 8 8 0 1 1 2 10 A 8 8 0 1 1 18 10";
                            stroke: (AppTheme.light ? #6d55bf : #b6a9ff); stroke-width: 1.7px;
                        }
                    }
                    FocusScope {
                        horizontal-stretch: 1;
                        capture-key-pressed(event) => {
                            if (event.text == Key.Escape) {
                                if (root.context-open) { root.context-open = false; }
                                else if (root.file-search-mode || root.clipboard-mode) { root.leave-file-search(); }
                                else { root.dismiss(); }
                                return accept;
                            }
                            if (event.text == Key.Return && event.modifiers.shift) {
                                root.launch-selected(root.selected-index, true);
                                return accept;
                            }
                            if (event.text == Key.DownArrow) {
                                root.selected-index = min(root.selected-index + 1, max(0, root.results.length - 1));
                                root.scroll-to-selection();
                                return accept;
                            }
                            if (event.text == Key.UpArrow) {
                                root.selected-index = max(root.selected-index - 1, 0);
                                root.scroll-to-selection();
                                return accept;
                            }
                            if (event.modifiers.control && (event.text == "r" || event.text == "R")) {
                                root.refresh(); return accept;
                            }
                            if (event.modifiers.control && (event.text == "q" || event.text == "Q")) {
                                root.quit(); return accept;
                            }
                            return reject;
                        }
                        if (root.query == ""): Text {
                            x: 0px; y: 0px; width: parent.width; height: parent.height;
                            text: root.clipboard-mode ? "搜索剪贴板记录" : (root.file-search-mode ? "搜索文件、文件夹或路径" : "搜索应用，输入 clp 查看剪贴板");
                            color: (AppTheme.light ? #74717f : #717482);
                            font-size: 23px;
                            vertical-alignment: center;
                        }
                        search := TextInput {
                            x: 0px; y: 0px; width: parent.width; height: parent.height;
                            text <=> root.query;
                            color: (AppTheme.light ? #211e2e : #f0eef8);
                            font-size: 23px;
                            vertical-alignment: center;
                            single-line: true;
                            selection-background-color: #6d5bc5;
                            selection-foreground-color: white;
                            edited => {
                                root.context-open = false;
                                root.selected-index = 0;
                                results-view.content-y = 0px;
                                root.query-edited(self.text);
                            }
                            accepted => { root.launch-selected(root.selected-index, false); }
                        }
                    }
                    KeyCap { label: "ESC"; }
                }
            }

            Rectangle { visible: !root.addon-panel-open; height: 1px; background: (AppTheme.light ? #dedce6 : #2c2e37); }

            Rectangle {
                visible: !root.addon-panel-open;
                height: 36px;
                HorizontalLayout {
                    padding-left: 22px; padding-right: 22px;
                    Text {
                        text: root.clipboard-mode ? "剪贴板记录" : root.file-search-mode
                            ? (root.file-indexing ? "正在建立文件索引…" : (root.file-querying ? "正在搜索文件…" : "文件搜索"))
                            : (root.scanning ? "正在发现应用…" : (root.query == "" ? "全部应用" : "搜索结果"));
                        color: (AppTheme.light ? #686575 : #858896); font-size: 11px;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Text {
                        text: root.file-search-mode && root.file-match-count > root.results.length
                            ? "显示 " + root.results.length + " / " + root.file-match-count + " 项"
                            : root.results.length + " 个";
                        color: (AppTheme.light ? #74717f : #686c7b); font-size: 11px; vertical-alignment: center;
                    }
                }
            }

            Rectangle {
                visible: !root.addon-panel-open;
                vertical-stretch: 1;
                results-view := ListView {
                    x: 10px; width: parent.width - 20px;
                    height: parent.height;
                    horizontal-scrollbar-policy: always-off;
                    for app[index] in root.results: Rectangle {
                        x: 0px;
                        width: results-view.visible-width;
                        height: 66px;
                        border-radius: 10px;
                        background: root.selected-index == index ? (AppTheme.light ? #625580 : #100d19).with-alpha(0.5) : (row-touch.has-hover ? (AppTheme.light ? #625580 : #100d19).with-alpha(0.3) : transparent);
                        border-width: root.selected-index == index ? 1px : 0px;
                        border-color: (AppTheme.light ? #c6bddb : #49405f);
                        HorizontalLayout {
                            padding-left: 12px; padding-right: 14px; spacing: 13px;
                            Rectangle {
                                width: 38px;
                                Rectangle {
                                    y: (parent.height - 38px) / 2;
                                    width: 38px; height: 38px; border-radius: 10px;
                                    background: app.has-icon ? transparent : app.tint.with-alpha(0.13);
                                    if (app.has-icon): Image {
                                        source: app.icon;
                                        image-fit: contain;
                                        width: parent.width;
                                        height: parent.height;
                                    }
                                    if (!app.has-icon): Text {
                                        text: app.monogram; color: app.tint;
                                        font-size: 18px; font-weight: 600;
                                        horizontal-alignment: center; vertical-alignment: center;
                                    }
                                }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                alignment: center;
                                Text { text: app.name; color: (AppTheme.light ? #292735 : #e7e7ef); font-size: 14px; overflow: elide; }
                                Text { text: app.detail; color: (AppTheme.light ? #686575 : #818391); font-size: 11px; overflow: elide; }
                            }
                            if (root.selected-index == index): Text {
                                text: root.launching ? "…" : (app.monogram == "SS" || app.monogram == "CLP" ? "进入" : (root.clipboard-mode || app.monogram == "=" ? "复制" : (app.addon-result ? "执行" : "打开")));
                                color: (AppTheme.light ? #6146a8 : #b2a2e8); font-size: 11px; width: 30px;
                                vertical-alignment: center;
                            }
                        }
                        row-touch := TouchArea {
                            clicked => { root.selected-index = index; root.launch-selected(index, false); }
                            pointer-event(event) => {
                                if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                                    root.selected-index = index;
                                    root.context-index = index;
                                    root.context-app = app.app-result && !root.file-search-mode && !root.clipboard-mode;
                                    root.context-path = root.file-search-mode || (root.context-app && app.has-path);
                                    root.context-x = min(max(0px, self.absolute-position.x + self.mouse-x - 12px), parent.width - 196px);
                                    root.context-y = min(max(0px, self.absolute-position.y + self.mouse-y - 12px), root.height - 220px);
                                    root.context-open = true;
                                }
                            }
                        }
                    }
                }
                if (root.results.length == 0): VerticalLayout {
                    alignment: center; spacing: 12px;
                    Text {
                        text: root.clipboard-mode ? "没有剪贴板记录" : root.file-search-mode
                            ? (root.file-indexing ? "正在建立文件索引" : (root.file-querying ? "正在搜索" : "没有找到匹配的文件或文件夹"))
                            : (root.scanning ? "正在整理你的应用" : "没有找到匹配的应用");
                        color: (AppTheme.light ? #514b62 : #c3bed6); font-size: 17px; horizontal-alignment: center;
                    }
                    Text {
                        text: root.clipboard-mode ? "复制文本或图片后会自动记录" : root.file-search-mode
                            ? (root.file-indexing ? "索引在后台建立，完成后自动显示结果" : (root.file-backend-active == 3 ? "试试其他搜索词，或检查 Everything 是否运行" : (root.file-count == 0 ? "请先在设置中添加文件索引范围" : "试试文件、文件夹名称或路径，Ctrl + R 重建索引")))
                            : (root.scanning ? "稍等片刻，即可开始" : "试试其他名称，或按 Ctrl + R 重新扫描");
                        color: (AppTheme.light ? #696777 : #747785); font-size: 12px; horizontal-alignment: center;
                    }
                    if root.file-search-mode: Button { text: "设置索引范围"; clicked => { root.open-file-search-settings(); } }
                }
            }

            if (root.error-message != "" || (root.file-search-mode ? root.file-index-status != "" : root.notice != "")): Rectangle {
                visible: !root.addon-panel-open;
                height: 34px;
                Text {
                    x: 22px; width: parent.width - 44px;
                    text: root.error-message != "" ? root.error-message : (root.file-search-mode ? root.file-index-status : root.notice);
                    color: root.error-message != "" ? (AppTheme.light ? #a72e39 : #ef9b9b) : (AppTheme.light ? #765b22 : #b5a47a);
                    font-size: 11px; overflow: elide; vertical-alignment: center;
                }
            }

            Rectangle { visible: !root.addon-panel-open; height: 1px; background: (AppTheme.light ? #dedce6 : #2c2e37); }
            Rectangle {
                visible: !root.addon-panel-open;
                height: 44px;
                HorizontalLayout {
                    padding-left: 20px; padding-right: 20px; spacing: 7px;
                    KeyCap { label: "↑ ↓"; }
                    Text { text: "选择"; font-size: 11px; color: (AppTheme.light ? #696777 : #7d8090); vertical-alignment: center; }
                    Rectangle { width: 6px; }
                    KeyCap { label: "Enter"; }
                    Text { text: root.clipboard-mode || root.calculation-selected ? "复制" : (root.file-search-mode ? "打开" : (root.addon-selected-result ? "执行" : "打开应用")); font-size: 11px; color: (AppTheme.light ? #696777 : #7d8090); vertical-alignment: center; }
                    Rectangle { width: 6px; }
                    if !root.file-search-mode && !root.clipboard-mode && !root.calculation-selected && !root.addon-selected-result: KeyCap { label: "Shift + Enter"; }
                    if !root.file-search-mode && !root.clipboard-mode && !root.calculation-selected && !root.addon-selected-result: Text { text: "新开"; font-size: 11px; color: (AppTheme.light ? #696777 : #7d8090); vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    Text {
                        text: root.clipboard-mode ? "最多保存 100 条记录" : root.file-search-mode ? (root.file-backend-active == 3 ? root.file-count + " 项结果" : root.file-count + " 项已索引") : (root.scanning ? "扫描中" : root.total-count + " 个应用已就绪");
                        font-size: 11px; color: (AppTheme.light ? #696777 : #747785);
                        vertical-alignment: center;
                    }
                    Rectangle {
                        width: 28px;
                        Rectangle {
                            y: (parent.height - 26px) / 2;
                            width: 28px; height: 26px; border-radius: 6px;
                            background: refresh-touch.has-hover ? (AppTheme.light ? #625580 : #100d19).with-alpha(0.4) : transparent;
                            Text { text: "↻"; color: (AppTheme.light ? #665784 : #9893b5); font-size: 19px; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        refresh-touch := TouchArea { clicked => { root.refresh(); } }
                    }
                }
            }
        }

        if root.context-open && !root.settings-open: Rectangle {
            width: parent.width; height: parent.height;
            background: transparent;
            TouchArea { clicked => { root.context-open = false; root.focus-search(); } }
            Rectangle {
                x: root.context-x; y: root.context-y;
                width: 196px;
                height: menu.preferred-height + 12px;
                background: (AppTheme.light ? #ffffff : #24232d);
                border-color: (AppTheme.light ? #c9c5d2 : #494251); border-width: 1px; border-radius: 10px;
                menu := VerticalLayout {
                    padding: 6px; spacing: 2px;
                    ContextItem {
                        label: root.clipboard-mode || root.calculation-selected ? "复制" : (root.addon-selected-result ? "执行" : (root.file-search-mode || root.context-app ? "打开" : "进入"));
                        shortcut: "Enter";
                        activated => { root.context-open = false; root.launch-selected(root.context-index, false); }
                    }
                    if root.context-app: ContextItem {
                        label: "新开实例"; shortcut: "Shift + Enter";
                        activated => { root.context-open = false; root.launch-selected(root.context-index, true); }
                    }
                    if root.context-path: ContextItem {
                        label: "复制路径";
                        activated => { root.context-open = false; root.copy-result-path(root.context-index); root.focus-search(); }
                    }
                    Rectangle { height: 1px; background: (AppTheme.light ? #dedce6 : #3a3844); }
                    ContextItem {
                        label: root.file-search-mode ? "重建文件索引" : "刷新"; shortcut: "Ctrl + R";
                        activated => { root.context-open = false; root.refresh(); root.focus-search(); }
                    }
                    ContextItem {
                        label: "设置";
                        activated => { root.context-open = false; root.open-settings(); }
                    }
                }
            }
        }

        Rectangle {
            x: 1px; y: 45px;
            width: parent.width - 2px; height: parent.height - 46px;
            visible: root.addon-panel-open && !root.settings-open;
            background: transparent;
            TouchArea { }
            panel-focus := FocusScope {
                capture-key-pressed(event) => {
                    if (event.text == Key.Escape) { root.addon-panel-close(); root.focus-search(); return accept; }
                    return reject;
                }
                VerticalLayout {
                    padding: 20px; spacing: 8px;
                    HorizontalLayout {
                        spacing: 12px;
                        Text { text: root.addon-panel-title; color: (AppTheme.light ? #211e2e : #f0eef8); font-size: 20px; font-weight: 600; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        Button { text: "返回"; clicked => { root.addon-panel-close(); root.focus-search(); } }
                    }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 6px;
                            for field[index] in root.addon-panel-fields: VerticalLayout {
                                spacing: 4px;
                                Text { text: field.label; color: (AppTheme.light ? #292735 : #e7e7ef); font-size: 12px; }
                                if field.kind == 0: TextEdit {
                                    height: 90px; text: field.value; enabled: !root.addon-panel-busy;
                                    init => { if (field.key == root.addon-panel-focus) { self.focus(); } }
                                    property <int> focus-request: root.addon-panel-focus-request;
                                    changed focus-request => { if (field.key == root.addon-panel-focus) { self.focus(); } }
                                    key-pressed(event) => {
                                        if (event.text == Key.Return && !event.modifiers.shift && !event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta) {
                                            if (!root.addon-panel-busy) { root.addon-panel-submit(); }
                                            return accept;
                                        }
                                        return reject;
                                    }
                                    edited(value) => { root.addon-panel-edited(index, value); }
                                }
                                if field.kind == 3: LineEdit {
                                    text: field.value; enabled: !root.addon-panel-busy;
                                    init => { if (field.key == root.addon-panel-focus) { self.focus(); } }
                                    property <int> focus-request: root.addon-panel-focus-request;
                                    changed focus-request => { if (field.key == root.addon-panel-focus) { self.focus(); } }
                                    edited(value) => { root.addon-panel-edited(index, value); }
                                    accepted => { root.addon-panel-submit(); }
                                }
                                if field.kind == 1: ComboBox {
                                    model: field.options; current-index: field.option-index; enabled: !root.addon-panel-busy;
                                    selected(value) => { root.addon-panel-edited(index, value); }
                                }
                                if field.kind == 2: TextEdit { height: 90px; text: field.value; read-only: true; }
                            }
                        }
                    }
                    Text { text: root.addon-panel-message; color: (AppTheme.light ? #a72e39 : #ef9b9b); font-size: 12px; wrap: word-wrap; }
                    Button { text: root.addon-panel-busy ? "处理中…" : root.addon-panel-submit-label; enabled: !root.addon-panel-busy; clicked => { root.addon-panel-submit(); } }
                }
            }
        }

        settings-panel := SettingsPanel {
            x: 1px; y: 45px;
            width: parent.width - 2px; height: parent.height - 46px;
            visible: root.settings-open;
            window-width-draft <=> root.window-width-draft;
            window-height-draft <=> root.window-height-draft;
            save-window-size(width, height) => { root.save-window-size(width, height); }
            set-theme(mode) => { root.set-theme(mode); }
            background-busy: root.background-busy;
            background-path <=> root.background-path;
            background-rotation <=> root.background-rotation;
            background-opacity <=> root.background-opacity;
            background-blur <=> root.background-blur;
            save-appearance(path, opacity, blur, rotation) => { root.save-appearance(path, opacity, blur, rotation); }
            browse-background => { root.browse-background(); }
            clear-background-cache => { root.clear-background-cache(); }
            autostart-registered: root.autostart-registered;
            autostart-available: root.autostart-available;
            autostart-busy: root.autostart-busy;
            autostart-system-settings: root.autostart-system-settings;
            autostart-failed: root.autostart-failed;
            autostart-status: root.autostart-status;
            autostart-message: root.autostart-message;
            set-autostart(enabled) => { root.set-autostart(enabled); }
            refresh-autostart => { root.refresh-autostart(); }
            open-autostart-system-settings => { root.open-autostart-system-settings(); }
            addon-fields: root.addon-fields;
            addon-field-edited(index, value) => { root.addon-field-edited(index, value); }
            addon-save-fields(index) => { root.addon-save-fields(index); }
            addon-list: root.addon-list;
            addon-selected <=> root.addon-selected;
            addon-manifest-draft <=> root.addon-manifest-draft;
            addon-config-draft <=> root.addon-config-draft;
            addon-enabled: root.addon-enabled;
            addon-message: root.addon-message;
            addon-failed: root.addon-failed;
            addon-select(index) => { root.addon-select(index); }
            addon-dialog-open: root.addon-dialog-open;
            addon-browse => { root.addon-browse(); }
            addon-add(path) => { root.addon-add(path); }
            addon-remove(index) => { root.addon-remove(index); }
            addon-set-enabled(index, enabled) => { root.addon-set-enabled(index, enabled); }
            addon-save-config(index, config) => { root.addon-save-config(index, config); }
            file-backend-draft <=> root.file-backend-draft;
            file-backend-program <=> root.file-backend-program;
            file-everything-available: root.file-everything-available;
            save-file-backend(kind, program) => { root.save-file-backend(kind, program); }
            file-roots-draft <=> root.file-roots-draft;
            file-indexing: root.file-indexing;
            file-settings-busy: root.file-settings-busy;
            file-folder-dialog-open: root.file-folder-dialog-open;
            file-settings-failed: root.file-settings-failed;
            file-index-status: root.file-index-status;
            file-settings-message: root.file-settings-message;
            save-file-roots(value) => { root.save-file-roots(value); }
            browse-file-folder => { root.browse-file-folder(); }
            rebuild-file-index => { root.rebuild-file-index(); }
            clear-file-index => { root.clear-file-index(); }
            draft <=> root.shortcut-draft;
            current-hotkey: root.hotkey-label;
            message: root.settings-message;
            failed: root.settings-failed;
            save(value) => { root.save-shortcut(value); }
            restore-default => { root.shortcut-draft = root.default-hotkey; root.settings-message = ""; root.settings-failed = false; settings-panel.focus-editor(); }
            close => { root.close-settings(); }
            capture-key(text, control, alt, shift, meta) => { root.capture-shortcut(text, control, alt, shift, meta); }
        }
    }
}
