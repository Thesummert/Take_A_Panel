{
  "api_version": 1,
  "id": "demo.greeting",
  "name": "问候示例",
  "keyword": "hello",
  "executable": "/usr/bin/env",
  "args": ["python3", "demo.py"],
  "settings": [
    {"key": "greeting", "type": "text", "label": "问候语", "description": "显示在搜索结果中的问候语。", "default": "你好"},
    {"key": "uppercase", "type": "boolean", "label": "大写问候语", "default": false},
    {"key": "punctuation", "type": "choice", "label": "结尾标点", "default": "无", "options": ["无", "！", "。"]},
    {"key": "repeat", "type": "integer", "label": "重复次数", "default": 1, "min": 1, "max": 3}
  ],
  "commands": [
    {"id": "about", "title": "关于问候插件", "detail": "查看插件说明"}
  ]
}
